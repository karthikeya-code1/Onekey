# Copy this file to .env and fill in your values
# cp .env.example .env

# PostgreSQL connection string (e.g. from Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT secret — use a long random string in production (e.g. openssl rand -base64 32)
JWT_SECRET="change-me-to-a-long-random-secret"
